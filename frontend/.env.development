# Dati finti: il frontend risponde da src/services/datiFinti.ts senza toccare
# la rete. Il backend REST adesso c'e', quindi sta a 0 e le chiamate vanno
# davvero a /api. Rimettere 1 solo per lavorare sull'interfaccia con Spring
# spento (ricordandosi di riavviare `npm run dev`: le variabili si leggono
# all'avvio).
VITE_FINTO=0

# Dove gira Spring Boot. E' la 8081 e non la 8080 di application.properties
# perche' su questa macchina la 8080 e' occupata: l'applicazione si avvia con
#   ./mvnw spring-boot:run -Dspring-boot.run.arguments=--server.port=8081
# Le due cose devono combaciare, altrimenti il proxy bussa alla porta sbagliata
# e ogni chiamata risponde "il server non risponde".
VITE_BACKEND=http://localhost:8081
